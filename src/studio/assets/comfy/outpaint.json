{
 "_meta": {
  "title": "outpaint: extend the canvas and fill the new border"
 },
 "nodes": {
  "10": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "$prompt",
    "clip": "@CLIP"
   }
  },
  "11": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "$negative",
    "clip": "@CLIP"
   }
  },
  "20": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "$image"
   }
  },
  "25": {
   "class_type": "ImagePadForOutpaint",
   "inputs": {
    "image": [
     "20",
     0
    ],
    "left": "$left",
    "top": "$top",
    "right": "$right",
    "bottom": "$bottom",
    "feathering": "$feather"
   }
  },
  "26": {
   "class_type": "VAEEncodeForInpaint",
   "inputs": {
    "pixels": [
     "25",
     0
    ],
    "vae": "@VAE",
    "mask": [
     "25",
     1
    ],
    "grow_mask_by": 8
   }
  },
  "13": {
   "class_type": "KSampler",
   "inputs": {
    "model": "@MODEL",
    "seed": "$seed",
    "steps": "$steps",
    "cfg": "$cfg",
    "sampler_name": "$sampler",
    "scheduler": "$scheduler",
    "positive": [
     "10",
     0
    ],
    "negative": [
     "11",
     0
    ],
    "latent_image": [
     "26",
     0
    ],
    "denoise": 1.0
   }
  },
  "14": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "13",
     0
    ],
    "vae": "@VAE"
   }
  },
  "15": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "14",
     0
    ],
    "filename_prefix": "$prefix"
   }
  }
 }
}