{
 "_meta": {
  "title": "image \u2192 image (denoise = strength)"
 },
 "nodes": {
  "10": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "$prompt",
    "clip": "@CLIP"
   }
  },
  "11": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "$negative",
    "clip": "@CLIP"
   }
  },
  "20": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "$image"
   }
  },
  "21": {
   "class_type": "VAEEncode",
   "inputs": {
    "pixels": [
     "20",
     0
    ],
    "vae": "@VAE"
   }
  },
  "13": {
   "class_type": "KSampler",
   "inputs": {
    "model": "@MODEL",
    "seed": "$seed",
    "steps": "$steps",
    "cfg": "$cfg",
    "sampler_name": "$sampler",
    "scheduler": "$scheduler",
    "positive": [
     "10",
     0
    ],
    "negative": [
     "11",
     0
    ],
    "latent_image": [
     "21",
     0
    ],
    "denoise": "$denoise"
   }
  },
  "14": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "13",
     0
    ],
    "vae": "@VAE"
   }
  },
  "15": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "14",
     0
    ],
    "filename_prefix": "$prefix"
   }
  }
 }
}